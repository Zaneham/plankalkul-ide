{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Plankalkül",
  "scopeName": "source.plankalkul",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#variables" },
    { "include": "#numbers" },
    { "include": "#plan-declaration" },
    { "include": "#truth-table" },
    { "include": "#type-annotations" },
    { "include": "#greek-prefixes" },
    { "include": "#quantifiers" },
    { "include": "#iterators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.plankalkul",
          "match": ";.*$"
        },
        {
          "name": "comment.block.plankalkul",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.loop.plankalkul",
          "match": "\\b(W|W0|W1|W2|W3|W4|W5|W6)\\b"
        },
        {
          "name": "keyword.control.plankalkul",
          "match": "\\b(FIN|END)\\b"
        },
        {
          "name": "keyword.other.plan.plankalkul",
          "match": "\\bP\\b"
        },
        {
          "name": "keyword.other.table.plankalkul",
          "match": "\\bTABLE\\b"
        },
        {
          "name": "constant.language.boolean.plankalkul",
          "match": "\\b(true|false|TRUE|FALSE)\\b"
        }
      ]
    },
    "greek-prefixes": {
      "patterns": [
        {
          "name": "keyword.other.greek.plankalkul",
          "match": "\\b(Delta|Sigma|Phi|DELTA|SIGMA|PHI|Δ|Σ|Φ)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.plankalkul",
          "match": "=>"
        },
        {
          "name": "keyword.operator.conditional.plankalkul",
          "match": "->"
        },
        {
          "name": "keyword.operator.equivalence.plankalkul",
          "match": "<->"
        },
        {
          "name": "keyword.operator.comparison.plankalkul",
          "match": "(<=|>=|!=|/=|<|>|=)"
        },
        {
          "name": "keyword.operator.arithmetic.plankalkul",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.logical.plankalkul",
          "match": "[&|!~]"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.parameter.input.plankalkul",
          "match": "\\b[Vv]\\d+\\b"
        },
        {
          "name": "variable.other.intermediate.plankalkul",
          "match": "\\b[Zz]\\d+\\b"
        },
        {
          "name": "variable.other.result.plankalkul",
          "match": "\\b[Rr]\\d+\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.plankalkul",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.plankalkul",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "plan-declaration": {
      "patterns": [
        {
          "name": "entity.name.function.plankalkul",
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.plankalkul" }
          }
        }
      ]
    },
    "truth-table": {
      "patterns": [
        {
          "name": "constant.other.truth-value.positive.plankalkul",
          "match": "(?<=\\s|\\|)\\+(?=\\s|\\||$)"
        },
        {
          "name": "constant.other.truth-value.negative.plankalkul",
          "match": "(?<=\\s|\\|)-(?=\\s|\\||$)"
        }
      ]
    },
    "type-annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.plankalkul",
          "match": "\\[:[^\\]]+\\]"
        }
      ]
    },
    "quantifiers": {
      "patterns": [
        {
          "name": "keyword.operator.quantifier.forall.plankalkul",
          "match": "\\(\\s*[Zz]\\d+\\s*\\)\\s*(?=\\()"
        },
        {
          "name": "keyword.operator.quantifier.exists.plankalkul",
          "match": "\\(\\s*[Ee][Zz]\\d+\\s*\\)"
        }
      ]
    },
    "iterators": {
      "patterns": [
        {
          "name": "keyword.operator.iterator.mu.plankalkul",
          "match": "[uUμ](?=[Zz]\\d)"
        },
        {
          "name": "keyword.operator.iterator.lambda.plankalkul",
          "match": "[\\\\λ](?=[Zz]\\d)"
        },
        {
          "name": "keyword.operator.filter.plankalkul",
          "match": "[\\^'](?=[Zz]\\d)"
        },
        {
          "name": "keyword.operator.cardinality.plankalkul",
          "match": "\\bN(?=\\()"
        }
      ]
    }
  }
}
